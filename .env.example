# ==============================================================================
# ENVIRONMENT VARIABLES - SIM GKJ MIJEN
# Salin file ini menjadi .env.local untuk environment lokal.
# Jangan pernah memasukkan file .env.local atau credentials asli ke dalam Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NEXT.JS PUBLIC CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="SIM GKJ Mijen"
NEXT_PUBLIC_APP_DESCRIPTION="Sistem Informasi Manajemen Gereja Kristen Jawa Mijen"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. SUPABASE CONFIGURATION (CLIENT-SIDE ACCESSIBLE)
# ------------------------------------------------------------------------------
# URL project instance Supabase Anda
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"

# Publishable key (sb_publishable_...) atau anon key lama (eyJ...).
# Ambil di Supabase: Project Settings > API Keys. Aman untuk browser, dibatasi oleh RLS.
# Jika URL / key ini masih contoh, aplikasi berjalan dalam MODE DEMO (data contoh).
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"

# ------------------------------------------------------------------------------
# 3. SUPABASE CONFIGURATION (SERVER-SIDE ONLY - SECRET)
# ------------------------------------------------------------------------------
# OPSIONAL & RAHASIA. Saat ini TIDAK dipakai aplikasi (semua akses lewat RLS).
# Jangan diisi kecuali benar-benar perlu, dan JANGAN pernah di-commit ke GitHub.
# SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."


# ------------------------------------------------------------------------------
# 4. STORAGE BUCKETS
# ------------------------------------------------------------------------------
# Bucket dibuat oleh supabase/schema.sql (tidak perlu diatur di sini):
#   bukti-transaksi (privat), lampiran (privat), surat (privat), publik (publik)
