# ==============================================================================
# ENVIRONMENT VARIABLES - SIM GKJ MIJEN
# Salin file ini menjadi .env.local untuk environment lokal.
# Jangan pernah memasukkan file .env.local atau credentials asli ke dalam Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NEXT.JS PUBLIC CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="SIM GKJ Mijen"
NEXT_PUBLIC_APP_DESCRIPTION="Sistem Informasi Manajemen Gereja Kristen Jawa Mijen"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. SUPABASE CONFIGURATION (CLIENT-SIDE ACCESSIBLE)
# ------------------------------------------------------------------------------
# URL project instance Supabase Anda
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"

# Supabase Public Anonymous API Key (aman untuk browser, dibatasi oleh RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"

# ------------------------------------------------------------------------------
# 3. SUPABASE CONFIGURATION (SERVER-SIDE ONLY - SECRET)
# ------------------------------------------------------------------------------
# Supabase Service Role Key (BYPASS ROW LEVEL SECURITY - HANYA DI SERVER ACTIONS / BACKEND)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# ------------------------------------------------------------------------------
# 4. STORAGE BUCKETS CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_STORAGE_BUCKET_DOCS="documents"
NEXT_PUBLIC_STORAGE_BUCKET_WARTE="warta"
NEXT_PUBLIC_STORAGE_BUCKET_AVATARS="avatars"
